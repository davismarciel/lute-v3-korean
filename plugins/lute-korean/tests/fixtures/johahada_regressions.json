[
  {
    "note_id": 1784072371653,
    "text": "맥주는 좋아하는데 소주는 안 좋아해요."
  },
  {
    "note_id": 1784072371655,
    "text": "커피는 좋아하는데 차는 안 좋아해요."
  },
  {
    "note_id": 1784072371727,
    "text": "뭐 좋아해요?"
  },
  {
    "note_id": 1784072371729,
    "text": "뭘 좋아해요?"
  },
  {
    "note_id": 1784072371731,
    "text": "무엇을 좋아해요?"
  },
  {
    "note_id": 1784072371761,
    "text": "그래서 소주는 안 좋아해요."
  },
  {
    "note_id": 1784072371783,
    "text": "강아지는 상자를 좋아하는데 드라이빙도 좋아해요."
  },
  {
    "note_id": 1784072371785,
    "text": "고양이는 상자를 좋아하는데 드라이빙은 안 좋아해요."
  },
  {
    "note_id": 1784129923451,
    "text": "차는 안 좋아해요."
  },
  {
    "note_id": 1784129923453,
    "text": "맥주는 좋아하는데 소주는 안 좋아해요."
  },
  {
    "note_id": 1784129923457,
    "text": "그래서 안 좋아해요."
  },
  {
    "note_id": 1789261653519,
    "text": "차는 안 좋아하는데 커피는 좋아해요."
  },
  {
    "note_id": 1789354088687,
    "text": "저는 아침에 일찍 일어나는 걸 정말 안 좋아해요."
  },
  {
    "note_id": 1789354089868,
    "text": "매운 음식은 정말 안 좋아해요."
  },
  {
    "note_id": 1789354091797,
    "text": "저는 소주를 정말 안 좋아해요."
  },
  {
    "note_id": 1789354097914,
    "text": "기다리는 건 정말 안 좋아해요."
  },
  {
    "note_id": 1789354106794,
    "text": "사람이 너무 많은 곳은 정말 안 좋아해요."
  }
]
